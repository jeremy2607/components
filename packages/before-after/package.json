{
  "name": "@jeremyprat/before-after",
  "version": "0.1.0",
  "description": "Comparateur avant / après dont le séparateur est un vrai curseur : clavier et lecteurs d'écran compris, sans une ligne de gestion d'événement.",
  "license": "MIT",
  "author": "Jeremy Prat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy2607/components.git",
    "directory": "packages/before-after"
  },
  "homepage": "https://github.com/jeremy2607/components/tree/main/packages/before-after#readme",
  "keywords": [
    "react",
    "before-after",
    "image-comparison",
    "slider",
    "accessibility",
    "real-estate"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
